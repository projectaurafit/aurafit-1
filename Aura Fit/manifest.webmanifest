{
  "name": "Aura Fit — AI Personal Wardrobe",
  "short_name": "Aura Fit",
  "description": "Organise your wardrobe, get outfit ideas, and find similar or matching pieces.",
  "id": "/aura-fit/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#111312",
  "theme_color": "#111312",
  "categories": ["lifestyle", "shopping", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add an item",
      "short_name": "Add item",
      "description": "Photograph a new piece of clothing",
      "url": "./index.html#/add",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Outfit ideas",
      "short_name": "Ideas",
      "description": "See looks generated from your wardrobe",
      "url": "./index.html#/ideas",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My wardrobe",
      "short_name": "Wardrobe",
      "description": "Browse everything you own",
      "url": "./index.html#/wardrobe",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
